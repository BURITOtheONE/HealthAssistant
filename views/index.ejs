<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Assistant</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

    <!-- Lucide icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-body">

    <!-- Navbar -->
    <%- include('partials/navbar') %>

    <!-- Main Content -->
    <div id="meal-container" class="container py-4"></div>

    <!-- Recipe Modal -->
    <%- include('partials/recipeModal') %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Bootstrap 5 JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Replaced load logic to fetch all meals in parallel (6 at once),
        // use event delegation for recipe buttons, ensure images load eagerly,
        // and clear any spinner/placeholders in the modal before populating.
        document.addEventListener('DOMContentLoaded', loadMeals);

        async function loadMeals() {
            const mealContainer = document.getElementById('meal-container');
            mealContainer.innerHTML = '';

            const total = 6;
            // fetch all meals in parallel
            const meals = await Promise.all(Array.from({ length: total }, () => fetchRandomMeal()));

            // render into two rows of 3
            for (let row = 0; row < 2; row++) {
                const rowDiv = document.createElement('div');
                rowDiv.className = 'row';
                mealContainer.appendChild(rowDiv);

                for (let i = 0; i < 3; i++) {
                    const meal = meals[row * 3 + i];
                    if (!meal) continue;
                    renderMealCard(rowDiv, meal);
                }
            }
        }

        function renderMealCard(container, meal) {
            const col = document.createElement('div');
            col.className = 'col-sm-4';

            col.innerHTML = `
                <div class="card my-3 shadow-sm">
                    <img loading="eager" alt="${escapeHtml(meal.strMeal)}" class="card-img-top p-3 rounded-4" src="${meal.strMealThumb}">
                    <div class="card-body">
                        <h5 class="card-title">${escapeHtml(meal.strMeal)}</h5>
                        <p class="card-text">${escapeHtml(meal.strInstructions ? meal.strInstructions.substring(0, 150) : 'No description available')}...</p>
                        <button class="btn btn-avocado-out view-recipe-btn" data-id="${meal.idMeal}">
                            View Recipe
                        </button>
                    </div>
                </div>
            `;

            container.appendChild(col);

            if (!window.mealData) window.mealData = {};
            window.mealData[meal.idMeal] = meal;
        }

        // delegated click handler to avoid re-attaching listeners repeatedly
        document.getElementById('meal-container').addEventListener('click', (e) => {
            const btn = e.target.closest('.view-recipe-btn');
            if (!btn) return;
            showRecipeModal(btn.dataset.id);
        });

        // safe getter to avoid crashes if a partial doesn't include a specific element
        function el(id) {
            return document.getElementById(id) || null;
        }

        async function showRecipeModal(mealId) {
            const modalEl = el('recipe-modal');
            if (!modalEl) return;

            // show modal immediately with loader visible
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            const titleEl = el('recipe-modal-title');
            const loadingEl = el('recipe-loading');
            const contentEl = el('recipe-content');
            const errorEl = el('recipe-error');

            if (titleEl) titleEl.textContent = 'Loading recipe...';
            if (loadingEl) loadingEl.classList.remove('d-none');
            if (contentEl) contentEl.classList.add('d-none');
            if (errorEl) errorEl.classList.add('d-none');

            // try to get cached meal, fallback to lookup by id
            let meal = window.mealData && window.mealData[mealId];
            if (!meal) {
                try {
                    const res = await fetch(`https://www.themealdb.com/api/json/v1/1/lookup.php?i=${mealId}`);
                    const data = await res.json();
                    meal = data.meals && data.meals[0];
                    if (meal) {
                        if (!window.mealData) window.mealData = {};
                        window.mealData[meal.idMeal] = meal;
                    }
                } catch (err) {
                    console.error('Lookup failed', err);
                    // show error state if fetch fails and no cached meal
                    if (!meal) {
                        if (loadingEl) loadingEl.classList.add('d-none');
                        if (errorEl) errorEl.classList.remove('d-none');
                        if (titleEl) titleEl.textContent = 'Recipe not available';
                        return;
                    }
                }
            }

            if (!meal) {
                // no data after attempt
                if (loadingEl) loadingEl.classList.add('d-none');
                if (errorEl) errorEl.classList.remove('d-none');
                if (titleEl) titleEl.textContent = 'Recipe not available';
                return;
            }

            // populate modal content
            if (titleEl) titleEl.textContent = meal.strMeal || 'Untitled';
            const imgEl = el('recipe-modal-image');
            if (imgEl) {
                imgEl.src = meal.strMealThumb || '';
                imgEl.alt = meal.strMeal || 'Recipe image';
            }

            const instrEl = el('recipe-modal-instructions');
            if (instrEl) instrEl.textContent = meal.strInstructions || 'No instructions available.';

            const ingredientsList = el('recipe-modal-ingredients');
            if (ingredientsList) {
                ingredientsList.innerHTML = '';
                for (let i = 1; i <= 20; i++) {
                    const ing = meal[`strIngredient${i}`];
                    const measure = meal[`strMeasure${i}`];
                    if (ing && ing.trim() !== '') {
                        const li = document.createElement('li');
                        li.className = 'list-group-item';
                        li.textContent = `${(measure || '').trim()} ${(ing || '').trim()}`.trim();
                        ingredientsList.appendChild(li);
                    }
                }
            }

            // switch UI from loader -> content
            if (loadingEl) loadingEl.classList.add('d-none');
            if (contentEl) contentEl.classList.remove('d-none');
        }

        async function fetchRandomMeal() {
            const res = await fetch('https://www.themealdb.com/api/json/v1/1/random.php');
            const data = await res.json();
            return data.meals && data.meals[0];
        }

        async function searchMeals() {
            const query = document.getElementById('search-input').value.trim();
            const mealContainer = document.getElementById('meal-container');
            mealContainer.innerHTML = '';

            if (query === '') {
                return loadMeals();
            }

            const res = await fetch(`https://www.themealdb.com/api/json/v1/1/search.php?s=${encodeURIComponent(query)}`);
            const data = await res.json();

            if (!data.meals) {
                mealContainer.innerHTML = `<p class="text-center mt-4">No meals found for "${escapeHtml(query)}"</p>`;
                return;
            }

            const row = document.createElement('div');
            row.className = 'row';
            mealContainer.appendChild(row);

            data.meals.forEach(meal => {
                renderMealCard(row, meal);
            });
        }

        // small utility to avoid inserting raw HTML from API strings
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>

    <script>
        lucide.createIcons();
    </script>

</body>
</html>
